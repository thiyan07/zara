# Copy to .env and fill in. Never commit a filled .env.
ASSISTANT_TOKEN=change-me-to-a-long-random-value
LLM_PROVIDER=echo
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
ZARA_MEMORY_DB=/data/memory.db
ZARA_MISSION_DB=/data/missions.db
ZARA_AUDIT_DB=/data/audit.db
ZARA_EMBEDDINGS=hash
# ZARA_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Voice (all optional; auto = local engine when installed, else mock)
VOICE_ENABLED=true
STT_PROVIDER=auto
# STT_PROVIDER=mock — force mock; local — require local whisper (fail fast)
STT_MODEL=tiny.en
STT_DEVICE=cpu
TTS_PROVIDER=auto
# TTS_PROVIDER=mock — force mock; edge — pre-existing cloud TTS (not default)
# TTS_PROVIDER=local|piper — require local Piper (fail fast if missing)
# TTS_PROVIDER=nvidia|magpie — OPTIONAL hosted Magpie (needs key below)
# TTS_MODEL=/home/thiyan/.cache/zara-voice/en_US-lessac-medium.onnx
# TTS_VOICE=default
# NVIDIA hosted TTS (optional; reuses LLM_API_KEY unless overridden)
# TTS_NVIDIA_BASE_URL=grpc.nvcf.nvidia.com:443
# TTS_NVIDIA_MODEL is fixed by roster: magpie_tts_ensemble-Magpie-Multilingual
# TTS_NVIDIA_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
# TTS_NVIDIA_VOICE=Magpie-Multilingual.EN-US.Aria
# NVIDIA_TTS_API_KEY=  (only if different from LLM_API_KEY)
# STT: local faster-whisper is the default (auto). Hosted Parakeet primary:
# STT_PROVIDER=nvidia  (local faster-whisper stays as offline fallback)
# STT_MODEL=tiny.en   (local fallback model)
# NVIDIA hosted STT (optional; reuses LLM_API_KEY unless overridden)
# NVIDIA_STT_SERVER=grpc.nvcf.nvidia.com:443
# NVIDIA_STT_MODEL=parakeet-tdt-0_6b-v2  (English; Tamil NOT_SUPPORTED)
# NVIDIA_STT_FUNCTION_ID=d3fe9151-442b-4204-a70d-5fcc597fd610
# NVIDIA_STT_LANGUAGE=en-US
# NVIDIA_STT_API_KEY=  (only if different from LLM_API_KEY)
# AUDIO_INPUT_DEVICE=   (alsa -D name; empty = default)
# AUDIO_OUTPUT_DEVICE=  (alsa -D name; empty = default)
WAKE_WORD=Hey Zara
WAKE_ENABLED=false
# WAKE_* battery thresholds live in code (WakeConfig): pause 15%, resume 25%
