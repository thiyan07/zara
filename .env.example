# Copy to .env and fill in. Never commit a filled .env.
ASSISTANT_TOKEN=change-me-to-a-long-random-value
LLM_PROVIDER=echo
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
ZARA_MEMORY_DB=/data/memory.db
ZARA_MISSION_DB=/data/missions.db
ZARA_AUDIT_DB=/data/audit.db
ZARA_EMBEDDINGS=hash
# ZARA_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Voice (all optional; auto = local engine when installed, else mock)
VOICE_ENABLED=true
STT_PROVIDER=auto
# STT_PROVIDER=mock — force mock; local — require local whisper (fail fast)
STT_MODEL=tiny.en
STT_DEVICE=cpu
TTS_PROVIDER=auto
# TTS_PROVIDER=mock — force mock; edge — pre-existing cloud TTS (not default)
# TTS_MODEL=/home/thiyan/.cache/zara-voice/en_US-lessac-medium.onnx
# TTS_VOICE=default
# AUDIO_INPUT_DEVICE=   (alsa -D name; empty = default)
# AUDIO_OUTPUT_DEVICE=  (alsa -D name; empty = default)
WAKE_WORD=Hey Zara
WAKE_ENABLED=false
# WAKE_* battery thresholds live in code (WakeConfig): pause 15%, resume 25%
