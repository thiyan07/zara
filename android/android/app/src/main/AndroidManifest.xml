<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Runtime-requested (Activity-mediated, denial is a normal state). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- API 33+ runtime request; older versions auto-grant at install. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permissions (auto-granted): backend connectivity + state. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Boot-completed is observe-only: the receiver posts an opt-in
         "tap to resume" prompt. It cannot keep the agent alive (OS
         background restrictions); see ZaraBootReceiver. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Phase 1 system-control reads (ordinary permissions only). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- API 31+ runtime (Dart bridge reports honest unavailable when denied). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- TelephonyManager.isDataEnabled read (runtime on some builds). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Phase 2 tiered changes. CHANGE_WIFI_STATE/BLUETOOTH_ADMIN are
         ordinary (legacy direct paths only); WRITE_SECURE_SETTINGS is
         signature|privileged — declared here, effective only via the T1
         ADB grant (bridge checks at call time and reports the setup
         command otherwise). Companion signature permission: the main app
         never holds it, it only calls the companion provider. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Tier-3 lab companion call permission (signature): grantable only
         when both APKs share the lab keystore. Declaring it here is inert
         on ordinary builds; the bridge probes the companion at call time. -->
    <uses-permission android:name="dev.zara.permission.SYSCONTROL" />
    <!-- Rung-1 pilot (emulator lab only): granted ONLY via priv-app image
         allowlist, never via runtime request. Missing allowlist entry is
         boot-fatal on enforcing builds; see docs/research. -->
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <application
        android:label="zara_android"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Stage 10 diagnostic spike: Zara as a candidate system assistant.
             Presence here claims NOTHING — the OS/user decide. Status is
             reported truthfully via getAssistantStatus. -->
        <service
            android:name=".ZaraVoiceInteractionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction" />
        </service>
        <service
            android:name=".ZaraVoiceInteractionSessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionSessionService" />
            </intent-filter>
        </service>
        <!-- ASSIST entry point: the OS enumerates assistant candidates
             through ACTION_ASSIST activities. This proxy only opens the
             normal app surface (same as the launcher icon) and finishes. -->
        <activity
            android:name=".ZaraAssistProxyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Rung-2 pilot (emulator lab only, never Vivo): optional
              AccessibilityService for bounded screen snapshots + tap on
              allowlisted lab packages. Disabled until the operator enables
              it in Settings; the bridge reports supported=false until then. -->
        <service
            android:name=".ZaraA11yService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/zara_a11y_config" />
        </service>
        <!-- Post-reboot resume prompt (opt-in marker file, no secrets).
             No background execution: the receiver only notifies, and only
             when the user enabled it in Settings. Tapping opens the app,
             where credential-restore + register + loop run normally. -->
        <receiver
            android:name=".ZaraBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Phase 1 app-open targets (package visibility, no QUERY_ALL_PACKAGES). -->
        <package android:name="com.android.settings" />
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.google.android.calendar" />
    </queries>
</manifest>
