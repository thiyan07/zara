<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Lab-only: allow cleartext HTTP from DEBUG builds to the laptop
         Core over USB/WLAN (e.g. http://<laptop-lan-ip>:$PORT). Without
         this, Android 9+ blocks all non-loopback cleartext and pairing
         silently never leaves the phone. Release keeps the platform
         default (HTTPS only); do not copy this into main/. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
